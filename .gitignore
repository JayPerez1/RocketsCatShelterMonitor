# =========================
# KiCad (global safe ignores)
# =========================

# Lock files
*.lck
~*.lck

# Autosave files
_autosave-*
*.autosave.kicad_*
~*

# Backup folders and files
*-backups/
*.kicad_sch-bak
*.kicad_pcb-bak
*.kicad_pro-bak

# Project-local settings (user-specific)
*.kicad_prl

# Footprint & symbol cache
fp-info-cache

# Temporary / experimental routing files
*ROUTING_WORK*
*_WORK.kicad_pcb
*_WORK.kicad_pro

# Import / log noise
ImportLog.log

# =========================
# Windows noise
# =========================
Thumbs.db
Desktop.ini

# =========================
# Do NOT ignore real design files:
# .kicad_sch
# .kicad_pcb
# .kicad_pro
# =========================
